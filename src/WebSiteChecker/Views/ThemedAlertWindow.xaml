<Window x:Class="WebSiteChecker.Views.ThemedAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        MinWidth="360"
        MaxWidth="460">
    <Border Style="{StaticResource CardBorderStyle}" Margin="16" MinWidth="320">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBorder"
                        Grid.Column="0"
                        Width="40"
                        Height="40"
                        CornerRadius="20"
                        VerticalAlignment="Top"
                        Margin="0,0,14,0">
                    <TextBlock x:Name="IconText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>
                </Border>

                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="✕"
                        Width="28"
                        Height="28"
                        Padding="0"
                        FontSize="12"
                        VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CloseButton_Click"/>
            </Grid>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="22"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,20"/>

            <StackPanel Grid.Row="2"
                        x:Name="OkButtonPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Tamam"
                        MinWidth="90"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsDefault="True"
                        Click="OkButton_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        x:Name="YesNoButtonPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="Collapsed">
                <Button Content="Evet"
                        MinWidth="90"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"
                        IsDefault="True"
                        Click="YesButton_Click"/>
                <Button Content="Hayır"
                        MinWidth="90"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="NoButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
