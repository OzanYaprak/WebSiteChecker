<Window x:Class="WebSiteChecker.Views.SmtpSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMTP Ayarları"
        Height="520"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="SMTP Sunucu:" Margin="0,0,0,10"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="HostTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Port:" Margin="0,0,0,10"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="PortTextBox" Text="587" Margin="0,0,0,10"/>

        <CheckBox Grid.Row="2" Grid.Column="1" x:Name="UseSslCheckBox" Content="SSL kullan" IsChecked="True" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Kullanıcı adı:" Margin="0,0,0,10"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="UsernameTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Şifre:" Margin="0,0,0,10"/>
        <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="PasswordBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="Gönderen:" Margin="0,0,0,10"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="FromTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="Alıcı:" Margin="0,0,0,10"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="ToTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Text="Uyarı bekleme (dk):" Margin="0,0,0,10"/>
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="CooldownTextBox" Text="30" Margin="0,0,0,10"/>

        <CheckBox Grid.Row="8" Grid.Column="1" x:Name="RecoveryCheckBox" Content="Site tekrar erişilebilir olunca mail gönder" IsChecked="True" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Kaydet" Width="90" Margin="0,0,10,0" IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="İptal" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
