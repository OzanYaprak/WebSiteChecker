<Window x:Class="WebSiteChecker.Views.SmtpSettingsWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="SMTP Ayarları"

        Height="926"

        Width="655"

        MinHeight="420"

        MinWidth="480"

        WindowStartupLocation="CenterOwner"

        ResizeMode="CanResize"

        Background="{DynamicResource AppBackgroundBrush}">

    <Border Style="{StaticResource CardBorderStyle}" Margin="16">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>



            <ScrollViewer Grid.Row="0"

                          VerticalScrollBarVisibility="Auto"

                          HorizontalScrollBarVisibility="Disabled"

                          Padding="0,0,4,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="170"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>



                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Style="{StaticResource LogoContainerCompactStyle}" Margin="0,0,12,0">
                            <Image Source="pack://application:,,,/Assets/saglik-bakanligi-logo.png" Height="40" Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="E-posta Bildirimleri" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="HSSGM kurumsal SMTP ayarları" Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>



                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"

                            Background="{StaticResource NeutralBgBrush}"

                            BorderBrush="{StaticResource BorderBrush}"

                            BorderThickness="1"

                            CornerRadius="8"

                            Padding="12"

                            Margin="0,0,0,16">

                        <StackPanel>

                            <Button Content="Sağlık Bakanlığı (eposta.saglik.gov.tr) ön ayarı"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="12,6"
                                    Margin="0,0,0,8"
                                    Click="SaglikGovTrPresetButton_Click"/>

                            <Button Content="Gmail (Google) ön ayarı"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="12,6"
                                    Click="GmailPresetButton_Click"/>

                            <TextBlock Margin="0,8,0,0" Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap"
                                       Text="Kurumsal SMTP için SSL kapalı ve port 587 kullanılır. Şifreyi yalnızca bu pencereden kaydedin."/>
                        </StackPanel>

                    </Border>



                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="SMTP Sunucu" Margin="0,0,0,12"/>

                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="HostTextBox" Margin="0,0,0,12"/>



                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="Port" Margin="0,0,0,12"/>

                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="PortTextBox" Text="587" Margin="0,0,0,12"/>



                    <CheckBox Grid.Row="4" Grid.Column="1" x:Name="UseSslCheckBox" Content="SSL kullan" IsChecked="False" Margin="0,0,0,12"/>



                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="Kullanıcı adı" Margin="0,0,0,12"/>

                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="UsernameTextBox" Margin="0,0,0,12"/>



                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="Şifre" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,12">

                        <PasswordBox x:Name="PasswordBox"/>

                        <TextBlock x:Name="PasswordHintTextBlock"

                                   Margin="0,4,0,0"

                                   Style="{StaticResource SubtitleStyle}"

                                   TextWrapping="Wrap"

                                   Visibility="Collapsed"/>

                    </StackPanel>



                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="Gönderen" Margin="0,0,0,12"/>

                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="FromTextBox" Margin="0,0,0,12"/>



                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="Alıcı" Margin="0,0,0,12"/>

                    <TextBox Grid.Row="8" Grid.Column="1" x:Name="ToTextBox" Margin="0,0,0,12"/>



                    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="Uyarı bekleme (dk)" Margin="0,0,0,12"/>

                    <TextBox Grid.Row="9" Grid.Column="1" x:Name="CooldownTextBox" Text="30" Margin="0,0,0,12"/>



                    <CheckBox Grid.Row="10" Grid.Column="1" x:Name="RecoveryCheckBox"

                              Content="Site tekrar erişilebilir olunca mail gönder" IsChecked="True" Margin="0,0,0,4"/>

                </Grid>

            </ScrollViewer>



            <Border Grid.Row="1"

                    Margin="0,12,0,0"

                    Padding="0,12,0,0"

                    BorderBrush="{StaticResource BorderBrush}"

                    BorderThickness="0,1,0,0">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button Content="Kaydet" Style="{StaticResource SecondaryButtonStyle}" MinWidth="100" Margin="0,0,10,0"

                            IsDefault="True" Click="SaveButton_Click"/>

                    <Button Content="İptal" Style="{StaticResource SecondaryButtonStyle}" MinWidth="100" IsCancel="True"/>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</Window>

