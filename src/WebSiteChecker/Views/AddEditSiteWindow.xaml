<Window x:Class="WebSiteChecker.Views.AddEditSiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Site Ekle/Düzenle"
        Height="420"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Ad:" Margin="0,0,0,10"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="URL:" Margin="0,0,0,10"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="UrlTextBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Kontrol aralığı (sn):" Margin="0,0,0,10"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="IntervalTextBox" Text="60" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Zaman aşımı (sn):" Margin="0,0,0,10"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TimeoutTextBox" Text="10" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Beklenen HTTP kodu:" Margin="0,0,0,10"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="StatusCodeTextBox" Text="200" Margin="0,0,0,10"/>

        <CheckBox Grid.Row="5" Grid.Column="1" x:Name="EnabledCheckBox" Content="Aktif" IsChecked="True" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Kaydet" Width="90" Margin="0,0,10,0" IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="İptal" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
