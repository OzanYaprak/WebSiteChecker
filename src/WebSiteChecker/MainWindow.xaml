<Window x:Class="WebSiteChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WebSiteChecker.Models"
        Title="WebSiteChecker — HSSGM"
        Icon="pack://application:,,,/Assets/tray-icon.ico"
        ShowInTaskbar="True"
        Height="600"
        Width="1024"
        MinHeight="480"
        MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="24" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Style="{StaticResource LogoContainerStyle}"
                        Margin="0,0,16,0">
                    <Image Source="pack://application:,,,/Assets/hssgm-logo.png"
                           Height="56"
                           Stretch="Uniform"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Web Pages Health Status Control Panel" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="T.C. Sağlık Bakanlığı Hudut ve Sahiller Sağlık Genel Müdürlüğü"
                               Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Windows ile başlat"
                          IsChecked="{Binding RunAtStartup}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>
                <Button Content="{Binding ThemeToggleText}"
                        Command="{Binding ToggleThemeCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,12,0"
                        Padding="12,8"/>
                <Border VerticalAlignment="Center" CornerRadius="16" Padding="14,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMonitorPaused}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource WarningBgBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitorPaused}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding MonitorStatusText}" FontWeight="SemiBold" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitorPaused}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            </StackPanel>
        </Grid>

        <!-- Site list card -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="20,18,20,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="İzlenen Siteler" Style="{StaticResource SiteListHeaderTitleStyle}"/>
                            <TextBlock Text="{Binding SiteCountText}" Style="{StaticResource SiteListHeaderSubtitleStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="10"
                                Padding="10,6"
                                VerticalAlignment="Center"
                                Opacity="0.9">
                            <TextBlock Text="{Binding SiteCount}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Sites}"
                          SelectedItem="{Binding SelectedSite}"
                          IsReadOnly="True"
                          Margin="0,0,0,4">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Site" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SiteNameTextStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Adres" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Url}" Style="{StaticResource SiteUrlTextStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Durum" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                                                <Setter Property="Background" Value="{DynamicResource NeutralBgBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:SiteStatus.Up}">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:SiteStatus.Down}">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:SiteStatus.Checking}">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBgBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:SiteStatus.Up}">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:SiteStatus.Down}">
                                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:SiteStatus.Checking}">
                                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:SiteStatus.Up}">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:SiteStatus.Down}">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:SiteStatus.Checking}">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Son Kontrol" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastCheckedText}" Style="{StaticResource SiteMetaTextStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Yanıt Süresi" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ResponseTimeText}" Style="{StaticResource ResponseTimeTextStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Hata" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ErrorBadgeStyle}"
                                            ToolTip="{Binding LastError}"
                                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding LastError}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="150"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="İzleme" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource ActivePillStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource NeutralBgBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Aktif"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Text" Value="Pasif"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0" Padding="16,12">
            <WrapPanel Orientation="Horizontal">
                <Button Content="Site Ekle" Command="{Binding AddSiteCommand}" Style="{StaticResource SiteAddButtonStyle}" Margin="0,0,8,8"/>
                <Button Content="Düzenle" Command="{Binding EditSiteCommand}" Margin="0,0,8,8"/>
                <Button Content="Sil" Command="{Binding DeleteSiteCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,8"/>
                <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="4,4,12,4"/>
                <Button Content="Şimdi Kontrol Et" Command="{Binding CheckNowCommand}" Margin="0,0,8,8"/>
                <Button Content="Duraklat / Devam" Command="{Binding TogglePauseCommand}" Margin="0,0,8,8"/>
                <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="4,4,12,4"/>
                <Button Content="SMTP Ayarları" Command="{Binding OpenSmtpSettingsCommand}" Margin="0,0,8,8"/>
                <Button Content="Test Maili Gönder" Command="{Binding SendTestEmailCommand}" Margin="0,0,8,8"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
