<Window x:Class="WebSiteChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebSiteChecker"
        Icon="pack://application:,,,/Assets/tray-icon.ico"
        Height="520"
        Width="960"
        MinHeight="400"
        MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="WebSiteChecker" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="{Binding MonitorStatusText}" Foreground="#666" Margin="0,0,0,12"/>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Sites}"
                  SelectedItem="{Binding SelectedSite}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*"/>
                <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="130"/>
                <DataGridTextColumn Header="Son Kontrol" Binding="{Binding LastCheckedText}" Width="150"/>
                <DataGridTextColumn Header="Yanıt" Binding="{Binding ResponseTimeText}" Width="80"/>
                <DataGridTextColumn Header="Hata" Binding="{Binding LastError}" Width="180"/>
                <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsEnabled}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="Site Ekle" Command="{Binding AddSiteCommand}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Düzenle" Command="{Binding EditSiteCommand}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Sil" Command="{Binding DeleteSiteCommand}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Şimdi Kontrol Et" Command="{Binding CheckNowCommand}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Duraklat / Devam" Command="{Binding TogglePauseCommand}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="SMTP Ayarları" Command="{Binding OpenSmtpSettingsCommand}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Test Maili Gönder" Command="{Binding SendTestEmailCommand}" Padding="12,6"/>
        </StackPanel>

        <CheckBox Grid.Row="3"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Content="Windows ile başlat"
                  IsChecked="{Binding StartWithWindows}"
                  Margin="0,12,0,0"/>
    </Grid>
</Window>
