<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette: #222831, #393E46, #00ADB5, #EEEEEE -->
    <Color x:Key="AppBackgroundColor">#222831</Color>
    <Color x:Key="SurfaceColor">#393E46</Color>
    <Color x:Key="BorderColor">#4A5058</Color>
    <Color x:Key="TextPrimaryColor">#EEEEEE</Color>
    <Color x:Key="TextSecondaryColor">#B8BCC2</Color>
    <Color x:Key="PrimaryColor">#00ADB5</Color>
    <Color x:Key="PrimaryHoverColor">#26BDC4</Color>
    <Color x:Key="PrimaryPressedColor">#009CA3</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="SuccessBgColor">#1A3D34</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="DangerBgColor">#4A2A2A</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="WarningBgColor">#4A3D1A</Color>
    <Color x:Key="NeutralBgColor">#4A5058</Color>
    <Color x:Key="DataGridRowBackgroundColor">#393E46</Color>
    <Color x:Key="DataGridAlternatingRowColor">#32363E</Color>
    <Color x:Key="DataGridRowHoverColor">#454A52</Color>
    <Color x:Key="DataGridRowSelectedColor">#1E4A4D</Color>
    <Color x:Key="CheckBoxBoxBgColor">#393E46</Color>
    <Color x:Key="CardShadowColor">#000000</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}"/>
    <SolidColorBrush x:Key="NeutralBgBrush" Color="{StaticResource NeutralBgColor}"/>
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="{StaticResource DataGridRowBackgroundColor}"/>
    <SolidColorBrush x:Key="DataGridAlternatingRowBrush" Color="{StaticResource DataGridAlternatingRowColor}"/>
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="{StaticResource DataGridRowHoverColor}"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="{StaticResource DataGridRowSelectedColor}"/>
    <SolidColorBrush x:Key="CheckBoxBoxBgBrush" Color="{StaticResource CheckBoxBoxBgColor}"/>

</ResourceDictionary>
