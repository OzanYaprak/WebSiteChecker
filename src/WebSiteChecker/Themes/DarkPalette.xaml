<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AppBackgroundColor">#0F172A</Color>
    <Color x:Key="SurfaceColor">#1E293B</Color>
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="PrimaryColor">#E63946</Color>
    <Color x:Key="PrimaryHoverColor">#C8102E</Color>
    <Color x:Key="PrimaryPressedColor">#A50D25</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="SuccessBgColor">#064E3B</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="DangerBgColor">#7F1D1D</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="WarningBgColor">#78350F</Color>
    <Color x:Key="NeutralBgColor">#334155</Color>
    <Color x:Key="DataGridRowBackgroundColor">#1E293B</Color>
    <Color x:Key="DataGridAlternatingRowColor">#172033</Color>
    <Color x:Key="DataGridRowHoverColor">#283548</Color>
    <Color x:Key="DataGridRowSelectedColor">#4A1D28</Color>
    <Color x:Key="CheckBoxBoxBgColor">#1E293B</Color>
    <Color x:Key="CardShadowColor">#000000</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}"/>
    <SolidColorBrush x:Key="NeutralBgBrush" Color="{StaticResource NeutralBgColor}"/>
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="{StaticResource DataGridRowBackgroundColor}"/>
    <SolidColorBrush x:Key="DataGridAlternatingRowBrush" Color="{StaticResource DataGridAlternatingRowColor}"/>
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="{StaticResource DataGridRowHoverColor}"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="{StaticResource DataGridRowSelectedColor}"/>
    <SolidColorBrush x:Key="CheckBoxBoxBgBrush" Color="{StaticResource CheckBoxBoxBgColor}"/>

</ResourceDictionary>
